# ── Secrets ──────────────────────────────────────
.env
*.env

# ── Python ───────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Generated outputs (never commit tip sheets) ──
# Note: output/ itself is a tracked package (emailer, renderer, templates)
# — only the regenerated artifact subdirectories are ignored.
output/tipsheets/
output/candidates/
output/paper_desk/

# ── Logs (all runtime logs; scan_log.json untracked 2026-07-21 —
#    it appended ~47k lines per commit and is regenerated on each run) ──
logs/

# ── Runtime model state (cached in CI; do not commit) ──
data/iv_history/*.json

# ── Chain-quality readings (one row per ticker per scan, several scans a day) ──
data/data_quality_log.json

# ── Sentiment disk cache (NEWS_CACHE_TTL_MIN, regenerated hourly on every scan) ──
data/cache/

# ── OS / IDE ─────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp

# ── Personal trading record & working notes (kept local, never pushed) ──
# The repo is public. These carry trade-level P&L, win rates and internal session
# notes — the project's code is shared, the operator's record is not. They live on
# disk and in the local v0.9-mvp-local tag / feat/entry-timing branch.
VEGA_Trade_Audit_*.md
VEGA_vs_Tastytrade_Benchmark_*.md
VEGA_SESSION_UPDATE_2026-07-09.md
VEGA_Claude_Code_Session_*.md
VEGA_VSCode_Handoff_*.md
VEGA_EntryTiming_AsBuilt_*.md
VEGA_MVP_RUNBOOK.md
VEGA_Project_Review_*.md
VEGA_PAPER_DESK_README.md

# Ledger snapshots taken before a repair. Data, not source — and they carry the same
# contents as logs/, which is already ignored.
backups/ledgers/
